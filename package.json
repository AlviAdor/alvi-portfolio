    "@upstash/redis": "1.41.0",
    "dompurify": "3.4.17",
    "framer-motion": "14.9.1",
    "gsap": "3.15.1",
    "jsdom": "26.1.0",
    "lenis": "1.3.27",
    "lucide-react": "1.69.0",
    "next": "15.5.29",
    "next-intl": "4.14.9",
    "react": "19.3.1",
