# Copy to .env.local for development. In production, set these in the host's
# dashboard (Vercel → Project → Settings → Environment Variables).
# Every security feature degrades gracefully when its variables are absent,
# and GET /api/status reports which ones are active.

# ── Contact relay: Resend (free: 3,000 emails/month, 100/day) ────────────────
# https://resend.com/api-keys → "Sending access". The placeholder below is
# treated as NOT configured.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Must be the email that owns the Resend account until a domain is verified.
CONTACT_TO_EMAIL=sarker.faizal2537@gmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# ── HMAC form tokens (single-use, signed, anti-replay) ───────────────────────
# Required in production for the token check to be enforced. 32+ random chars:
#   openssl rand -hex 32
FORM_TOKEN_SECRET=

# ── Cloudflare Turnstile bot check (free) ────────────────────────────────────
# https://dash.cloudflare.com → Turnstile → Add widget (hostname = your domain).
# For local development you can use Cloudflare's public always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Upstash Redis rate limiting (free tier) ──────────────────────────────────
# https://console.upstash.com → Create database → REST API. Without these,
# rate limiting falls back to per-instance memory.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── GitHub (optional) ────────────────────────────────────────────────────────
# Unauthenticated: 60 requests/hour. A fine-grained token with
# "Public repositories (read-only)" raises that to 5,000/hour.
GITHUB_TOKEN=

# ── Research sync (optional overrides) ───────────────────────────────────────
OPENALEX_AUTHOR_ID=A5147350797
OPENALEX_MAILTO=

# ── Encrypted contact channel (optional) ─────────────────────────────────────
# Base URL of the Secure Auth Demo backend, with trailing slash. On that
# backend, set SAD_ALLOWED_ORIGIN to this site's exact origin.
NEXT_PUBLIC_SECURE_MESSAGING_BASE=

# ── Site ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alviador.is-a.dev
